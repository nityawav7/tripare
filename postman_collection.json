{
  "info": {
    "_postman_id": "c1f7b822-48f5-48ef-b0a3-d8c9735d10a2",
    "name": "Hotel Offer Orchestrator API",
    "description": "Postman Collection for testing Hotel Offer Orchestrator (Node.js TypeScript, Express, Temporal, Redis)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Core Endpoints",
      "item": [
        {
          "name": "GET Hotels - Delhi (Overlapping Aggregation)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [
                {
                  "key": "city",
                  "value": "delhi",
                  "description": "City to query with overlapping hotels"
                }
              ]
            },
            "description": "Calls Temporal workflow to fetch from Supplier A and B in parallel, deduplicates by lowest price, saves in Redis, and returns results."
          },
          "response": []
        },
        {
          "name": "GET Hotels - Delhi (Price Range Filtering inside Redis)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi&minPrice=5000&maxPrice=7000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                },
                {
                  "key": "minPrice",
                  "value": "5000"
                },
                {
                  "key": "maxPrice",
                  "value": "7000"
                }
              ]
            },
            "description": "Uses Redis ZRANGEBYSCORE to perform native price filtering inside Redis."
          },
          "response": []
        },
        {
          "name": "GET Hotels - City with No Results",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=nonexistentcity",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [
                {
                  "key": "city",
                  "value": "nonexistentcity"
                }
              ]
            },
            "description": "Queries a city that neither supplier has listings for. Returns an empty array []."
          },
          "response": []
        },
        {
          "name": "GET Hotels - Forced Refresh Workflow",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi&refresh=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                },
                {
                  "key": "refresh",
                  "value": "true"
                }
              ]
            },
            "description": "Bypasses Redis cache and forces a new Temporal workflow execution."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Supplier Mock Endpoints",
      "item": [
        {
          "name": "GET Supplier A Hotels",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/supplierA/hotels?city=delhi",
              "host": ["{{baseUrl}}"],
              "path": ["supplierA", "hotels"],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                }
              ]
            },
            "description": "Directly queries mock Supplier A API."
          },
          "response": []
        },
        {
          "name": "GET Supplier B Hotels",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/supplierB/hotels?city=delhi",
              "host": ["{{baseUrl}}"],
              "path": ["supplierB", "hotels"],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                }
              ]
            },
            "description": "Directly queries mock Supplier B API."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Fault Tolerance & Simulation (Bonus)",
      "item": [
        {
          "name": "Simulate Supplier A Down (Toggle)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"down\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/supplierA/toggle-status",
              "host": ["{{baseUrl}}"],
              "path": ["supplierA", "toggle-status"]
            },
            "description": "Simulates Supplier A failure (returns 503)."
          },
          "response": []
        },
        {
          "name": "GET Hotels when Supplier A is Down (Graceful Degradation)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi&refresh=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                },
                {
                  "key": "refresh",
                  "value": "true"
                }
              ]
            },
            "description": "Verifies that the Temporal workflow catches Supplier A failure and still returns Supplier B offers."
          },
          "response": []
        },
        {
          "name": "Restore Supplier A (Toggle)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"down\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/supplierA/toggle-status",
              "host": ["{{baseUrl}}"],
              "path": ["supplierA", "toggle-status"]
            },
            "description": "Restores Supplier A to healthy state."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Health Check (Bonus)",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Informs about the health and latency of Supplier A, Supplier B, Redis, and Temporal."
          },
          "response": []
        }
      ]
    }
  ]
}
